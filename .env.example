# ─────────────────────────────────────────────────────────────────────────────
# TRACE-X Environment Configuration
# Copy this file to .env and fill in the values.
# NEVER commit your real .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=tracex
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=tracex

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis_password

# ── Backend ───────────────────────────────────────────────────────────────────
# Must be at least 32 characters for HS256 JWT signing
SECRET_KEY=change_me_to_a_random_secret_key_min_32_chars

ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=60

# ── Blockchain Provider ───────────────────────────────────────────────────────
# Options: mock | evm
# Use "mock" for offline demo. Use "evm" for live Ethereum/BSC data.
BLOCKCHAIN_PROVIDER=mock

# Only needed when BLOCKCHAIN_PROVIDER=evm
ETH_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY

# ── Demo Data ─────────────────────────────────────────────────────────────────
# Set to "true" to seed deterministic demo cases on startup
SEED_DEMO_DATA=true

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
